# EconoMonitor environment variables
#
#   cp .env.sample .env.local
#
# .env.local is gitignored — never commit real keys.

# FRED API key (free) — https://api.stlouisfed.org/api_key.html
# Required. Powers every chart, search, category and release view.
FRED_API_KEY=

# FRASER API key (free) — https://fraser.stlouisfed.org
# Required for the Archives section. See BUILDING.md § 9 for the request steps.
FRASER_API_KEY=

# Azure OpenAI powers AI Insights and Chat.
#
# GitHub Models was fully retired on 2026-07-30, so Azure OpenAI (Microsoft
# Foundry) is now the only supported provider.
#
# In Azure the app authenticates with its managed identity, so only the
# endpoint and deployment are set as App Settings — there is no key to leak.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Local development only. Leave blank to authenticate as your own Azure CLI
# login (`az login`), which is preferred. Resources with `disableLocalAuth`
# set will reject API keys entirely.
# AZURE_OPENAI_API_KEY=

# --- Optional data feeds -----------------------------------------------------
#
# All three are free and only enhance individual pages. If a key is missing the
# page renders an explanatory empty state rather than failing.
#
# The /rates page needs no key at all — the Treasury yield curve and the New
# York Fed reference rates are both open feeds.

# EIA API key (free) — https://www.eia.gov/opendata/register.php
# Powers the /energy page: retail fuel, crude oil, and natural gas prices.
EIA_API_KEY=

# BEA API key (free) — https://apps.bea.gov/API/signup/
# Powers real GDP by state on the /regional page.
BEA_API_KEY=

# Census Bureau API key (free) — https://api.census.gov/data/key_signup.html
# Powers the retail sales and housing indicators on the /regional page.
CENSUS_API_KEY=
