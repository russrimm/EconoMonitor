# EconoMonitor environment variables
#
#   cp .env.sample .env.local
#
# .env.local is gitignored — never commit real keys.

# FRED API key (free) — https://api.stlouisfed.org/api_key.html
# Required. Powers every chart, search, category and release view.
FRED_API_KEY=

# FRASER API key (free) — https://fraser.stlouisfed.org
# Required for the Archives section. See BUILDING.md § 9 for the request steps.
FRASER_API_KEY=

# GitHub personal access token — Settings → Developer settings → Personal access
# tokens → Tokens (classic). No scopes are needed; it is only used to call the
# GitHub Models API. Required for AI Insights and Chat.
GITHUB_TOKEN=

# Optional: use Azure OpenAI instead of GitHub Models for the AI features.
# When both AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_API_KEY are set they take
# precedence over GITHUB_TOKEN.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
